<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseSystemDrawing>true</UseSystemDrawing>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TahoeCursorStudio</AssemblyName>
    <RootNamespace>TahoeCursorStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Tahoe Cursor Studio</Company>
    <Product>Tahoe 26 光标主题工作室</Product>
    <Description>深浅双色 Windows 光标预览、差异比较和一键应用工具</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.21" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <EmbeddedResource Include="..\..\cursor-theme.json" Link="Assets\cursor-theme.json" />
    <EmbeddedResource Include="..\..\Cursors\**\*.cur" Link="Assets\Cursors\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Cursors\**\*.ani" Link="Assets\Cursors\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
