<Window x:Class="TahoeCursorStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppName}" Width="1180" Height="860" MinWidth="1060" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/AppIcon.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="17,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}" /></Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsChecked" Value="False" /></MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#3A3A40" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="205" />
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,20,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ThemeTitle}" FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="#17171B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="13" Padding="4" Margin="18,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Variant" Style="{StaticResource SegmentButton}" Content="{DynamicResource DarkVariant}"
                                         IsChecked="{Binding IsDarkSelected, Mode=OneWay}" Command="{Binding SelectVariantCommand}" CommandParameter="dark" />
                            <RadioButton GroupName="Variant" Style="{StaticResource SegmentButton}" Content="{DynamicResource LightVariant}"
                                         IsChecked="{Binding IsLightSelected, Mode=OneWay}" Command="{Binding SelectVariantCommand}" CommandParameter="light" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1" Text="{DynamicResource Subtitle}" Foreground="{StaticResource MutedBrush}"
                           FontSize="13" Margin="1,4,0,0" />

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="#19442A" BorderBrush="#27693F" BorderThickness="1" CornerRadius="9" Padding="12,6">
                        <TextBlock Text="{Binding SystemStatus}" Foreground="#7CE2B1" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="18,0,0,0" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13,9">
                        <TextBlock Text="{Binding ThemeRoot}" TextTrimming="CharacterEllipsis" FontSize="12" />
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="{DynamicResource ChooseTheme}" Command="{Binding ChooseThemeCommand}" Margin="14,0,0,0" />
                    <Button Grid.Column="2" Style="{StaticResource PillButton}" Content="{DynamicResource RefreshDiff}" Command="{Binding RefreshCommand}" Margin="12,0,0,0" />
                    <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="{DynamicResource ApplyNow}" Command="{Binding ApplyCommand}" Margin="14,0,0,0" />
                </Grid>
            </Grid>

            <Border Grid.Row="1" Background="#17171B" BorderBrush="#2A2A2F" BorderThickness="1" CornerRadius="13" Margin="18,1,18,3">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="212" /><ColumnDefinition Width="155" /><ColumnDefinition Width="155" />
                        <ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource ColumnRole}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource ColumnActive}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource ColumnTarget}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{DynamicResource ColumnDiff}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{DynamicResource ColumnResult}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ListBox Grid.Row="2" ItemsSource="{Binding Roles}" Background="Transparent" BorderThickness="0"
                     Padding="18,12,12,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,6,12" /><Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" /><Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Height="100" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="17" Padding="18,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="212" /><ColumnDefinition Width="155" /><ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RoleType}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="80" Height="80" HorizontalAlignment="Left" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="15">
                                    <Image Source="{Binding Current}" Width="68" Height="68" RenderOptions.BitmapScalingMode="Fant" />
                                </Border>
                                <Border Grid.Column="2" Width="80" Height="80" HorizontalAlignment="Left" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="15">
                                    <Image Source="{Binding Target}" Width="68" Height="68" RenderOptions.BitmapScalingMode="Fant" />
                                </Border>
                                <Border Grid.Column="3" Width="80" Height="80" HorizontalAlignment="Left" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="15">
                                    <Image Source="{Binding Diff}" Width="68" Height="68" RenderOptions.BitmapScalingMode="Fant" />
                                </Border>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <Border x:Name="ResultBadge" BorderThickness="1"
                                            CornerRadius="10" Width="160" Height="30" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#5B1E33" />
                                                <Setter Property="BorderBrush" Value="#852A46" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMatching}" Value="True">
                                                        <Setter Property="Background" Value="#1F5333" />
                                                        <Setter Property="BorderBrush" Value="#2D7546" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF85A0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMatching}" Value="True">
                                                            <Setter Property="Foreground" Value="#7CE2B1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding ResourceText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Background="#141417">
                <TextBlock Text="{Binding Footer}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="24,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top" Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
